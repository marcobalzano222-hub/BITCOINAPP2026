  // bitcoin24
  const b24y=[now.getFullYear(),2030,2035,2045]; if(!b24y.includes(D.b24Year)) D.b24Year=now.getFullYear();
  $('b24Tabs').innerHTML = b24y.map(y=>`<button data-y="${y}" class="${D.b24Year===y?'on':''}">${y===now.getFullYear()?'heute':y}</button>`).join('');
  const isNow = D.b24Year===now.getFullYear(), bd = isNow ? now : new Date(D.b24Year,0,1);
  $('b24').innerHTML = tri([['Bear',conv(b24Price('bear',bd))],['Base',conv(b24Price('base',bd))],['Bull',conv(b24Price('bull',bd))]], stack, isNow?'Modellwert heute':'1.1.'+D.b24Year, true);

  // cycles
  $('cycle').innerHTML = [4,8,12].map(y=>{ const d=ago(y), v=priceAt(cur,d); if(!v) return '';
    return `<div class="row"><div class="l">${y} Jahren<small>${dateDE(d)}</small></div><div class="r">${fmtC(v)}<small class="${cls(p/v-1)}">${fmtS(p-v)} · seitdem ${fmtX(p/v)}</small></div></div>`; }).join('')
    || `<div class="mut">${D.day[cur].length?'Historie reicht nicht so weit zurück':'Historie lädt…'}</div>`;

  // year ends
  let rows=[]; let prevV=null;
  const first = D.day[cur].length ? new Date(D.day[cur][0][0]*1000).getFullYear() : now.getFullYear();
  for(let y=first;y<now.getFullYear();y++){
    const v=priceAt(cur,new Date(y,11,31,23,59)); if(!v){prevV=null;continue;}
    rows.push([String(y), v, prevV?(v/prevV-1)*100:null, prevV?v-prevV:null, YS[y]]); prevV=v;
  }
  rows.push([now.getFullYear()+' (heute)', p, prevV?(p/prevV-1)*100:null, prevV?p-prevV:null, ty]);
  rows.reverse();
  const hl = st => st ? `<small><span class="pos">▲</span> ${fmtC(st.hi)} <span class="neg">▼</span> ${fmtC(st.lo)}</small>` : '';
  $('years').innerHTML = rows.map(([y,v,x,a,st])=>`<tr><td>${y}</td><td>${fmtC(v)}${hl(st)}</td><td class="${cls(x)}">${fmtP(x)}<small>${fmtS(a)}</small></td></tr>`).join('');
  $('yearsSub').textContent = D.daySrc[cur]==='weekly' ? 'Schluss 31.12., Hoch/Tief (älter als 2 J: Wochenkurs)' : 'Schluss 31.12., Hoch und Tief je Jahr';
  const sm=(id,main,sub,k)=>{ $(id).innerHTML=`<span class="${k||''}">${main}</span>${sub?`<small>${sub}</small>`:''}`; };
  const ytd=priceAt(cur,ye); sm('perfSum', ytd?fmtP((p/ytd-1)*100):'–', ytd?fmtS(p-ytd)+' seit 1.1.':'', ytd?cls(p/ytd-1):'mut');
  if(mr){ const a=mr.avg[now.getMonth()]; sm('seasSum', fmtP(a), 'Ø '+MONL[now.getMonth()], cls(a)); }
  if(fair) sm('plSum', fmtP((p/fair-1)*100), 'zum Fair Value '+fmtC(fair), cls(p-fair));
  sm('b24Sum', fmtBig(conv(b24Price('base',now))), 'Base heute');
  const v4=priceAt(cur,ago(4)); sm('cycSum', v4?fmtX(p/v4):'–', v4?'seit '+dateDE(ago(4)):'', v4?cls(p/v4-1):'mut');
  sm('yearsSum', ty?fmtC(ty.hi):'–', ty?'Hoch '+now.getFullYear():'');

  renderMarkets();
  $('stamp').textContent = `Stand ${now.toLocaleTimeString('de-DE',{hour:'2-digit',minute:'2-digit'})} · Bitcoin und Gold (PAXG) von Kraken, Historie ${D.daySrc[cur]==='weekly'?'Kraken (Wochen)':'Bitstamp/CoinGecko'}${cur==='GOLD'?', Gold vor '+(D.goldDay.length?new Date(D.goldDay[0][0]*1000).getFullYear():2024)+' aus Jahresschlusskursen interpoliert':''}, Aktien von Finnhub, Block von mempool.space, Fear & Greed von alternative.me.`;
}
function tri(items, st, sub, big){
  return items.map(([k,v],i)=>`<div class="${i===1?'mid':''}"><div class="k">${k}</div><div class="v">${big?fmtBig(v):fmtC(v)}</div><div class="s">${st>0&&v?'Stack '+(big?fmtBig(v*st):fmtC(v*st)):sub&&i===1?sub:''}</div></div>`).join('');
}
function renderMarkets(){
  const box=$('markets'), err=$('mkErr');
  if(D.mkState==='loading'){ box.innerHTML='<div class="mut skel">lädt…</div>'; err.hidden=true; return; }
  const k=D.mkErrKind; err.hidden = !k;
  const keyBox = `<div class="stackbox" style="margin-top:8px"><input id="fhIn" type="text" autocapitalize="off" autocorrect="off" placeholder="Finnhub API-Key" value="${fhKey}"><button id="fhSave">Speichern</button></div>`;
  err.innerHTML = k==='nokey' ? `Für Aktienkurse braucht die App einen kostenlosen Finnhub-Key (finnhub.io). Hier eintragen, bleibt auf dem Gerät.${keyBox}`
    : k==='key' ? `Finnhub lehnt den Key ab – bitte prüfen.${keyBox}`
    : k==='limit' ? 'Finnhub-Limit erreicht, in einer Minute wieder. <button id="mkRetry">Erneut versuchen</button>' : '';
  const fs=$('fhSave'); if(fs) fs.onclick=()=>{ fhKey=$('fhIn').value.trim(); if(fhKey) localStorage.setItem(LS_FH,fhKey); else localStorage.removeItem(LS_FH); fetchMarkets(); };
  const stale = t => t && (Date.now()/1000-t) > 20*3600 ? ` · ${new Date(t*1000).toLocaleDateString('de-DE',{weekday:'short'})}-Schluss` : '';
  box.innerHTML = (D.mk||[]).map(m=>{
    const usd=m.price, eur=D.eurusd&&usd?usd/D.eurusd:null;
    let main;
    if(usd==null) main='–';
    else if(m.id==='GOLD') main = `${fmtC(cur==='EUR'?eur:usd,cur==='EUR'?'EUR':'USD',0)}<small class="mut">${fmtC(cur==='EUR'?usd:eur,cur==='EUR'?'USD':'EUR',0)}</small>`;
    else { const cc=cur==='GOLD'?'USD':cur; main = `${fmtC(cc==='EUR'?eur:usd,cc,2)}<small class="mut">${fmtC(cc==='EUR'?usd:eur,cc==='EUR'?'USD':'EUR',2)}</small>`; }
    const sub = usd==null ? '' : `${m.unit?m.unit+' · ':''}${m.src||''}${stale(m.t)}`;
    let extra='';
    if(m.detail && usd!=null && D.spot.USD){
      const btcVal=MSTR_BTC*D.spot.USD, mcap=m.mcap||usd*MSTR_SHARES, shares=m.mcap?m.mcap/usd:MSTR_SHARES, mnav=(mcap+MSTR_DEBT_USD)/btcVal, perShare=MSTR_BTC/shares;
      const w52 = m.w52h ? ` · 52 W ${fmtC(m.w52l,'USD',0)}–${fmtC(m.w52h,'USD',0)}` : '';
      extra=`<div class="note" style="margin:-2px 0 8px">${nf(MSTR_BTC,0)} ₿ im Bestand ≈ ${fmtBig(cur==='GOLD'?btcVal:conv(btcVal),cur==='GOLD'?'USD':cur)} · Börsenwert ${fmtBig(cur==='GOLD'?mcap:conv(mcap),cur==='GOLD'?'USD':cur)}${w52} · mNAV ${nf(mnav,2)}× · ${nf(perShare*1e8,0)} Sats je Aktie (≈ ${fmtC(cur==='GOLD'?perShare*D.spot.USD:perShare*D.spot[cur],cur==='GOLD'?'USD':cur,0)})</div>`;
    }
    return `<div class="row"><div class="l">${m.name}<small>${sub}</small></div><div class="r">${main}<span class="chg ${cls(m.chg)}">${fmtP(m.chg)}</span></div></div>${extra}`;
  }).join('');
  const rb=$('mkRetry'); if(rb) rb.onclick=()=>fetchMarkets();
  const ms=(D.mk||[]).find(m=>m.id==='MSTR');
  const gd=(D.mk||[]).find(m=>m.id==='GOLD');
  $('mkSum').innerHTML = ms&&ms.price!=null ? `<span class="${cls(ms.chg)}">${fmtP(ms.chg)}</span><small>MSTR ${fmtC(cur==='EUR'?ms.price/D.eurusd:ms.price,cur==='GOLD'?'USD':cur,0)}</small>`
    : gd&&gd.price ? `<span class="${cls(gd.chg)}">${fmtP(gd.chg)}</span><small>Gold ${fmtC(gd.price,'USD',0)}</small>` : '';
}

// ─────────────────────────────── boot
async function boot(){
  try{
    await fetchSpot();
    await Promise.all([fetchHours('USD'),fetchHours('EUR'),fetchHours('GOLD')]);
    render();
  }catch(e){ $('price').innerHTML='<span class="skel" style="font-size:20px">Kraken nicht erreichbar</span>'; console.warn(e); return; }
  fetchHeight().then(render); fetchFGI().then(render);
  fetchMarkets().catch(()=>{ D.mkState='fail'; renderMarkets(); });
  fetchNews().catch(()=>{});
  try{ await fetchGoldDaily(); }catch(e){ console.warn(e); }
  for(const c of (cur==='EUR'?['EUR','USD']:['USD','EUR'])){ try{ await fetchDaily(c); render(); }catch(e){ console.warn(e); } }
}
setInterval(async()=>{ try{ await fetchSpot(); render(); }catch(e){} }, 30000);
setInterval(async()=>{ try{ await Promise.all([fetchHours('USD'),fetchHours('EUR'),fetchHours('GOLD'),fetchGoldDaily(),fetchHeight(),fetchFGI()]); render(); fetchMarkets(); fetchNews(); }catch(e){} }, 600000);

// ─────────────────────────────── events
$('cur').addEventListener('click',e=>{ const b=e.target.closest('button'); if(!b) return;
  cur=b.dataset.c; localStorage.setItem(LS.cur,cur);
  [...$('cur').children].forEach(x=>x.classList.toggle('on',x.dataset.c===cur)); render(); });
[...$('cur').children].forEach(x=>x.classList.toggle('on',x.dataset.c===cur));
$('plTabs').addEventListener('click',e=>{ const b=e.target.closest('button'); if(b){ D.plYear=+b.dataset.y; render(); } });
$('b24Tabs').addEventListener('click',e=>{ const b=e.target.closest('button'); if(b){ D.b24Year=+b.dataset.y; render(); } });
$('newsTabs').addEventListener('click',e=>{ const b=e.target.closest('button'); if(b){ D.news.f=b.dataset.f; renderNews(); } });
$('months').addEventListener('click',e=>{ const b=e.target.closest('button'); if(b){ D.month=+b.dataset.m; render(); } });
$('stackSave').onclick=()=>{ const v=parseFloat(String($('stackIn').value).replace(',','.')); stack=v>0?v:0;
  if(stack>0) localStorage.setItem(LS.stack,stack); else localStorage.removeItem(LS.stack); render(); $('stackDet').open=false; };
$('stackClear').onclick=()=>{ stack=0; localStorage.removeItem(LS.stack); $('stackIn').value=''; render(); $('stackDet').open=false; };
$('stackIn').addEventListener('keydown',e=>{ if(e.key==='Enter') $('stackSave').click(); });
$('stackDet').addEventListener('toggle',()=>{ if($('stackDet').open) $('stackIn').value = stack>0 ? String(stack).replace('.',',') : ''; });
$('reload').onclick=()=>location.reload();
$('share').onclick=async()=>{
  const p=D.spot[cur]; const c24=priceHoursAgo(cur,24);
  const text = p ? `Bitcoin: ${fmtC(p)}${c24?` (${fmtP((p/c24-1)*100)} in 24 h)`:''}` : 'Bitcoin-Tracker';
  try{ if(navigator.share) await navigator.share({title:'Bitcoin',text,url:location.href});
       else { await navigator.clipboard.writeText(text+' '+location.href); $('share').style.color='var(--up)'; setTimeout(()=>$('share').style.color='',1200); } }catch(e){}
};
boot();
</script>
