// ─────────────────────────────── daily history since 2013
// Kraken only serves the latest 720 daily candles. Older days: CoinGecko → Bitstamp → Kraken weekly.
const START = 1325376000; // 2012-01-01
async function histCoinGecko(c){
  const r = await fetch(`https://api.coingecko.com/api/v3/coins/bitcoin/market_chart?vs_currency=${c.toLowerCase()}&days=max&interval=daily`);
  if(!r.ok) throw new Error('cg '+r.status);
  const j = await r.json();
  // points are 00:00 UTC = close of previous day → shift back one day to match candle-open convention
  return j.prices.map(p=>[Math.floor(p[0]/1000)-86400, p[1]]).filter(p=>p[1]>0);
}
async function histBitstamp(c, upTo){
  const pair = 'btc'+c.toLowerCase(); let start = START, out = [];
  for(let i=0;i<8;i++){
    const r = await fetch(`https://www.bitstamp.net/api/v2/ohlc/${pair}/?step=86400&limit=1000&start=${start}`);
    if(!r.ok) throw new Error('bs '+r.status);
    const j = await r.json(); const rows = (j.data&&j.data.ohlc)||[];
    if(!rows.length) break;
    rows.forEach(x=>out.push([+x.timestamp, parseFloat(x.close)]));
    start = +rows[rows.length-1].timestamp + 86400;
    if(rows.length<1000 || start>=upTo) break;
    await sleep(150);
  }
  if(!out.length) throw new Error('bs empty');
  return out;
}
async function histKrakenWeekly(c){
  const res = await kraken(`OHLC?pair=${PAIR[c]}&interval=10080`);
  return res[firstKey(res)].map(r=>[r[0], parseFloat(r[4])]);
}
async function fetchDaily(c){
  const key = LS.hist+c;
  let cached = {src:null, rows:[]}; try{ cached = JSON.parse(localStorage.getItem(key)) || cached; }catch(e){}
  const map = new Map(cached.rows);
  const res = await kraken(`OHLC?pair=${PAIR[c]}&interval=1440`);
  const kr = res[firstKey(res)].map(r=>[r[0], parseFloat(r[4])]);
  const oldest = kr[0][0];
  let src = cached.src;
  const covered = cached.rows.length && cached.rows[0][0] < START+500*86400 && (src==='daily');
  if(!covered){
    let old=null;
    try{ old = await histBitstamp(c, oldest); src='daily'; }catch(e){ console.warn('bitstamp',e); }
    if(!old || old[0][0] > START+200*86400){ try{ const cg = await histCoinGecko(c); old = (old||[]).concat(cg.filter(r=>!old||r[0]<old[0][0])); src='daily'; }catch(e){ console.warn('coingecko',e); } }
    if(!old){ try{ old = await histKrakenWeekly(c); src='weekly'; }catch(e){ console.warn('weekly',e); } }
    if(old) old.forEach(r=>{ if(r[0]<oldest) map.set(r[0],r[1]); });
  }
  kr.forEach(r=>map.set(r[0],r[1]));
  const all = [...map.entries()].sort((a,b)=>a[0]-b[0]);
  D.day[c] = all; D.daySrc[c] = src; deriveGold();
  try{ localStorage.setItem(key, JSON.stringify({src, rows:all})); }catch(e){}
}
function priceAt(c, date){
  const t = date.getTime()/1000, s = D.day[c]; if(!s.length) return null;
  let lo=0, hi=s.length-1, best=null;
  while(lo<=hi){ const m=(lo+hi)>>1; if(s[m][0]<=t){best=s[m];lo=m+1;} else hi=m-1; }
  if(!best || t-best[0] > 15*86400) return null;
  return best[1];
}
function priceHoursAgo(c,h){
  const s = D.hour[c]; if(!s.length) return null;
  const t = Date.now()/1000 - h*3600;
  let best=null; for(const r of s){ if(r[0]<=t) best=r; else break; }
  return best ? best[1] : null;
}

