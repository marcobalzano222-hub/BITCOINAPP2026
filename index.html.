function yearStats(c){
  const out={}, s=D.day[c];
  for(const [t,v] of s){ const y=new Date(t*1000).getFullYear();
    const o=out[y]||(out[y]={hi:-1,hiT:0,lo:Infinity,loT:0});
    if(v>o.hi){o.hi=v;o.hiT=t;} if(v<o.lo){o.lo=v;o.loT=t;} }
  const p=D.spot[c], y=new Date().getFullYear(), nowT=Date.now()/1000;
  if(p){ const o=out[y]||(out[y]={hi:-1,hiT:0,lo:Infinity,loT:0});
    if(p>o.hi){o.hi=p;o.hiT=nowT;} if(p<o.lo){o.lo=p;o.loT=nowT;} }
  return out;
}
function ath(c){ let best=null; for(const r of D.day[c]) if(!best||r[1]>best[1]) best=r;
  const p=D.spot[c]; if(p&&(!best||p>=best[1])) return {v:p,t:Date.now()/1000,now:true}; return best?{v:best[1],t:best[0]}:null; }

// ─────────────────────────────── seasonality
function monthlyReturns(c){
  const now=new Date(), s=D.day[c]; if(!s.length) return null;
  const firstY = new Date(s[0][0]*1000).getFullYear();
  const byMonth = Array.from({length:12},()=>[]); // {y, r}
  let current=null;
  for(let y=firstY;y<=now.getFullYear();y++) for(let m=0;m<12;m++){
    const isCur = y===now.getFullYear()&&m===now.getMonth();
    if(y===now.getFullYear()&&m>now.getMonth()) break;
    const prev = priceAt(c,new Date(y,m,0,23,59)); if(!prev) continue;
    const end = isCur ? D.spot[c] : priceAt(c,new Date(y,m+1,0,23,59)); if(!end) continue;
    const r=(end/prev-1)*100;
    if(isCur) current={y,r}; else byMonth[m].push({y,r});
  }
  const avg = byMonth.map(a=>a.length?a.reduce((x,o)=>x+o.r,0)/a.length:null);
  return {byMonth,avg,current,firstY};
}

