// ─────────────────────────────── models
const GENESIS = Date.UTC(2009,0,3);
const plFair = date => 1.0117e-17 * Math.pow((date.getTime()-GENESIS)/864e5, 5.82);
const PL_LO = 0.42, PL_HI = 3;
const B24 = { start:Date.UTC(2024,0,1), p0:45000, end:Date.UTC(2045,0,1),
  cases:{ bear:{target:3e6,rEnd:.10}, base:{target:13e6,rEnd:.20}, bull:{target:49e6,rEnd:.30} } };
function b24Path(r0,rEnd,tMs){
  const years = (tMs-B24.start)/(365.25*864e5); if(years<=0) return B24.p0;
  const N=21; let lp=Math.log(B24.p0);
  for(let y=0;y<Math.min(years,N);y++){ const r = r0+(rEnd-r0)*(y/(N-1)); lp += Math.min(1,years-y)*Math.log(1+r); }
  return Math.exp(lp);
}
for(const k in B24.cases){ const c=B24.cases[k]; let lo=0,hi=5;
  for(let i=0;i<60;i++){ const mid=(lo+hi)/2; b24Path(mid,c.rEnd,B24.end)<c.target?lo=mid:hi=mid; } c.r0=(lo+hi)/2; }
const b24Price = (k,date) => b24Path(B24.cases[k].r0,B24.cases[k].rEnd,date.getTime());

