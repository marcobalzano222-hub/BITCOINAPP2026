<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Bitcoin">
<meta name="theme-color" content="#f7f6f3" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#101214" media="(prefers-color-scheme: dark)">
<title>Bitcoin</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='48' fill='%23f7931a'/%3E%3Ctext x='50' y='70' font-size='58' font-family='-apple-system,Helvetica,Arial' font-weight='700' fill='white' text-anchor='middle'%3E%E2%82%BF%3C/text%3E%3C/svg%3E">
<style>
:root{
  --bg:#f7f6f3; --ink:#111213; --ink2:#5a5b5e; --ink3:#9a9b9e; --rule:#e2e1dd; --rule2:#cfcec9;
  --btc:#e8830f; --up:#1d8a4a; --down:#c8381d; --band:#ecebe7; --chip:#edece8;
  --upbg:rgba(29,138,74,.13); --downbg:rgba(200,56,29,.13);
}
@media (prefers-color-scheme: dark){
  :root{ --bg:#101214; --ink:#f2f2f0; --ink2:#a8a9ab; --ink3:#6d6e70; --rule:#24272a; --rule2:#34373a;
         --btc:#f7931a; --up:#3fbf70; --down:#f0634a; --band:#1a1d20; --chip:#1c1f22;
         --upbg:rgba(63,191,112,.16); --downbg:rgba(240,99,74,.16); }
}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%}
body{
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Helvetica Neue",Helvetica,Arial,sans-serif;
  background:var(--bg); color:var(--ink); font-size:16px; line-height:1.4;
  font-variant-numeric:tabular-nums; -webkit-font-smoothing:antialiased;
  padding:max(14px,env(safe-area-inset-top)) 0 max(28px,env(safe-area-inset-bottom));
}
.wrap{max-width:460px;margin:0 auto;padding:0 20px}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer;-webkit-tap-highlight-color:transparent}
button:focus-visible,input:focus-visible{outline:2px solid var(--btc);outline-offset:2px}
input{font:inherit;color:inherit}

.top{display:flex;align-items:center;justify-content:space-between;padding:6px 0 26px}
.brand{font-weight:700;letter-spacing:-.01em;font-size:17px;display:flex;align-items:center;gap:8px}
.brand .b{width:22px;height:22px;border-radius:50%;background:var(--btc);color:#fff;font-size:14px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;line-height:1}
.tr{display:flex;align-items:center;gap:8px}
.seg{display:inline-flex;background:var(--chip);border-radius:9px;padding:2px}
.seg button{padding:5px 10px;border-radius:7px;font-size:13px;font-weight:600;color:var(--ink2)}
.seg button.on{background:var(--bg);color:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.12)}
.icon{width:32px;height:32px;border-radius:9px;background:var(--chip);display:inline-flex;align-items:center;justify-content:center;color:var(--ink2)}
.icon svg{width:16px;height:16px}

.hero .lab{font-size:13px;color:var(--ink2)}
.hero .price{font-size:52px;font-weight:700;letter-spacing:-.035em;line-height:1.05;margin:2px 0 4px}
.hero .sub{display:flex;align-items:baseline;gap:10px;font-size:15px;flex-wrap:wrap}
.hero .sub b{font-weight:600}
.hero .alt{color:var(--ink2)}
.hero .stack,.hero .net{margin-top:8px;font-size:13px;color:var(--ink3)}
.fgi{margin-top:12px}
.fgibar{position:relative;height:6px;border-radius:3px;background:linear-gradient(90deg,var(--down),#e3a008 50%,var(--up))}
.fgidot{position:absolute;top:50%;width:12px;height:12px;border-radius:50%;background:var(--ink);border:2px solid var(--bg);transform:translate(-50%,-50%)}
.fgitxt{display:flex;gap:6px;align-items:baseline;font-size:13px;margin-top:6px;color:var(--ink2)}
.fgitxt b{color:var(--ink);font-size:15px}
.fgitxt #fgiD{margin-left:auto;font-size:12px}
.halv{margin-top:12px}
.halvtop{display:flex;justify-content:space-between;font-size:13px;color:var(--ink2)}
.halvtop span:last-child{color:var(--ink);font-weight:600}
.halvbar{height:6px;border-radius:3px;background:var(--chip);margin-top:6px;overflow:hidden}
.halvbar div{height:100%;background:var(--btc);border-radius:3px;width:0}
.halvsub{font-size:12px;color:var(--ink3);margin-top:5px}
.hero .stack b{color:var(--ink2);font-weight:600}
.spark{display:block;width:100%;height:64px;margin:16px 0 4px}
.spark-cap{display:flex;justify-content:space-between;font-size:11px;color:var(--ink3)}

.pos{color:var(--up)} .neg{color:var(--down)} .mut{color:var(--ink3)}
.sec{border-top:1px solid var(--rule)}
.sec summary{list-style:none;display:flex;align-items:center;gap:10px;padding:15px 0;cursor:pointer;font-size:15px;font-weight:600}
.sec summary::-webkit-details-marker{display:none}
.sec summary .t{flex:1;min-width:0}
.sec summary .t small{display:block;font-size:12px;font-weight:400;color:var(--ink3);margin-top:1px}
.sec summary .sum{font-size:14px;font-weight:600;text-align:right;white-space:nowrap}
.sec summary .sum small{display:block;font-size:11px;font-weight:400;color:var(--ink3)}
.sec summary .ch{width:18px;height:18px;color:var(--ink3);flex-shrink:0;transition:transform .2s}
.sec[open] summary .ch{transform:rotate(180deg)}
.sec .body{padding:2px 0 22px}
@media (prefers-reduced-motion:reduce){.sec summary .ch{transition:none}}
.sections{margin-top:22px}
.row{display:flex;justify-content:space-between;align-items:baseline;padding:9px 0;border-bottom:1px solid var(--rule);gap:12px}
.row:last-child{border-bottom:0}
.row .l{font-size:15px;min-width:0}
.row .l small{display:block;font-size:12px;color:var(--ink3);margin-top:1px}
.row .r{text-align:right;flex-shrink:0;font-size:15px}
.row .r small{display:block;font-size:12px;margin-top:1px}
.row .r .chg{font-size:13px;font-weight:600;margin-left:8px}

.perf{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.perf div{background:var(--chip);border-radius:10px;padding:10px 12px}
.perf .k{font-size:12px;color:var(--ink2)}
.perf .v{font-size:17px;font-weight:700;letter-spacing:-.01em;margin-top:2px}
.perf .a{font-size:12px;color:var(--ink3);margin-top:1px}

.corr{margin:6px 0 14px}
.corr .bar{position:relative;height:8px;border-radius:4px;background:linear-gradient(90deg,var(--up),var(--band) 40%,var(--band) 60%,var(--down))}
.corr .dot{position:absolute;top:50%;width:16px;height:16px;border-radius:50%;background:var(--btc);border:3px solid var(--bg);transform:translate(-50%,-50%);box-shadow:0 0 0 1px var(--rule2)}
.corr .lbl{display:flex;justify-content:space-between;font-size:11px;color:var(--ink3);margin-top:6px}
.three{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:6px}
.three div{padding:6px 0}
.three .k{font-size:12px;color:var(--ink2)}
.three .v{font-size:16px;font-weight:700;letter-spacing:-.01em;margin-top:1px}
.three .s{font-size:11px;color:var(--ink3)}
.three .mid .v{color:var(--btc)}
.note{font-size:12px;color:var(--ink3);margin-top:8px;line-height:1.45}
.tabs{display:flex;gap:4px;margin-bottom:8px;flex-wrap:wrap}
.tabs button{font-size:12px;padding:4px 10px;border-radius:14px;background:var(--chip);color:var(--ink2)}
.tabs button.on{background:var(--ink);color:var(--bg)}

.months{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:12px}
.months button{border-radius:9px;padding:8px 4px 7px;text-align:center;background:var(--chip);border:2px solid transparent}
.months button.up{background:var(--upbg)} .months button.dn{background:var(--downbg)}
.months button.now{border-color:var(--btc)}
.months button.on{border-color:var(--ink)}
.months .m{font-size:11px;color:var(--ink2)}
.months .v{font-size:14px;font-weight:700;letter-spacing:-.01em}
.yrs{display:flex;flex-wrap:wrap;gap:5px}
.yrs span{font-size:12px;padding:4px 7px;border-radius:7px;background:var(--chip)}
.yrs span.up{background:var(--upbg)} .yrs span.dn{background:var(--downbg)}
.yrs span i{font-style:normal;color:var(--ink3);margin-right:4px}

table{width:100%;border-collapse:collapse;font-size:14px}
td{padding:7px 0;border-bottom:1px solid var(--rule);vertical-align:baseline}
tr:last-child td{border-bottom:0}
td:nth-child(2),td:nth-child(3){text-align:right}
td:first-child{color:var(--ink2)}
.tt{display:inline-flex;align-items:center;gap:7px}
.ni{width:17px;height:17px;color:var(--ink2)}
.news a{display:block;padding:10px 0;border-bottom:1px solid var(--rule);color:inherit;text-decoration:none}
.news a:last-child{border-bottom:0}
.news .h{font-size:15px;line-height:1.35;font-weight:500}
.news .m{font-size:12px;color:var(--ink3);margin-top:3px}
.news .m b{font-weight:500;color:var(--ink2)}
td small{display:block;font-size:11px;color:var(--ink3);white-space:nowrap}

details summary{list-style:none;font-size:14px;color:var(--ink2);cursor:pointer;padding:4px 0}
details summary::-webkit-details-marker{display:none}
.stackbox{display:flex;gap:8px;margin-top:10px}
.stackbox input{flex:1;padding:11px 12px;border:1px solid var(--rule2);border-radius:10px;background:var(--bg);font-size:16px;min-width:0}
.stackbox button{padding:0 14px;border-radius:10px;background:var(--ink);color:var(--bg);font-weight:600;font-size:14px}
.stackbox button.ghost{background:var(--chip);color:var(--ink2)}

footer{padding-top:22px;font-size:11px;color:var(--ink3);line-height:1.6}
footer button{color:var(--ink2);text-decoration:underline}
.err{font-size:12px;color:var(--ink2);margin-top:6px;padding:8px 10px;background:var(--chip);border-radius:8px}
.err button{text-decoration:underline;color:var(--ink)}
.skel{color:var(--ink3)}
</style>
</head>
<body>
<div class="wrap">

<div class="top">
  <div class="brand"><span class="b">₿</span>Bitcoin</div>
  <div class="tr">
    <div class="seg" id="cur"><button data-c="EUR">EUR</button><button data-c="USD">USD</button><button data-c="GOLD">Gold</button></div>
    <button class="icon" id="share" aria-label="Teilen"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M7 8l5-5 5 5M5 14v6h14v-6"/></svg></button>
  </div>
</div>

<div class="hero">
  <div class="lab" id="heroLab">1 Bitcoin</div>
  <div class="price" id="price"><span class="skel">lädt…</span></div>
  <div class="sub"><span id="chg24"></span><span class="alt" id="alt"></span></div>
  <div class="stack" id="stackLine" hidden></div>
  <div class="net" id="net"></div>
  <div class="fgi" id="fgi" hidden><div class="fgibar"><div class="fgidot" id="fgiDot"></div></div><div class="fgitxt"><b id="fgiV"></b> <span id="fgiL"></span> <span class="mut">Fear &amp; Greed</span><span id="fgiD" class="mut"></span></div></div>
  <div class="halv" id="halv" hidden><div class="halvtop"><span>Halving</span><span id="halvR"></span></div><div class="halvbar"><div id="halvFill"></div></div><div class="halvsub" id="halvS"></div></div>
  <div class="net" id="ath"></div>
  <svg class="spark" id="spark" viewBox="0 0 400 64" preserveAspectRatio="none" aria-hidden="true"></svg>
  <div class="spark-cap"><span>vor 1 Jahr</span><span id="sparkRange"></span><span>heute</span></div>
</div>

<div class="sections">
<details class="sec"><summary><span class="t">Entwicklung<small id="perfSub">je Bitcoin, mit absoluter Veränderung</small></span><span class="sum" id="perfSum"></span><svg class="ch" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary><div class="body"><div class="perf" id="perf"></div></div></details>
<details class="sec"><summary><span class="t">Saisonalität<small id="seasSub">Ø Monatsrendite seit 2013</small></span><span class="sum" id="seasSum"></span><svg class="ch" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary><div class="body"><div class="months" id="months"></div><div id="monthYears"></div></div></details>
<details class="sec"><summary><span class="t">Power Law<small id="plSub">Santostasi-Modell</small></span><span class="sum" id="plSum"></span><svg class="ch" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary><div class="body"><div class="corr"><div class="bar"><div class="dot" id="plDot" style="left:50%"></div></div>
    <div class="lbl"><span>Bottom</span><span id="plPos"></span><span>Top</span></div></div>
  <div class="three" id="pl"></div>
  <div class="tabs" id="plTabs"></div>
  <div class="three" id="plFuture"></div>
  <div class="note">Fair Value ≈ 1,0117·10⁻¹⁷ · Tage seit Genesis<sup>5,82</sup>. Bottom = 0,42× Fair, Top = 3× Fair. Historisch lagen Zyklustiefs am Bottom-Band, Zyklushochs unter dem Top-Band.</div></div></details>
<details class="sec"><summary><span class="t">Bitcoin24<small id="b24Sub">Michael Saylor, 2024–2045</small></span><span class="sum" id="b24Sum"></span><svg class="ch" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary><div class="body"><div class="tabs" id="b24Tabs"></div>
  <div class="three" id="b24"></div>
  <div class="note">Modellpfad ab 45.000 $ (Jan 2024) mit jährlich sinkender Rendite bis zu Saylors Zielwerten 2045: Bear 3 Mio., Base 13 Mio., Bull 49 Mio. $. Umrechnung in EUR zum heutigen Kurs.</div></div></details>
<details class="sec"><summary><span class="t">Letzter Zyklus<small id="cycSub">heute vor 4, 8 und 12 Jahren</small></span><span class="sum" id="cycSum"></span><svg class="ch" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary><div class="body"><div id="cycle"></div></div></details>
<details class="sec"><summary><span class="t">Jahresschluss<small id="yearsSub">Schluss 31.12., Hoch und Tief je Jahr</small></span><span class="sum" id="yearsSum"></span><svg class="ch" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary><div class="body"><table id="years"></table></div></details>
<details class="sec"><summary><span class="t">Märkte<small id="mkSub">24 h</small></span><span class="sum" id="mkSum"></span><svg class="ch" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary><div class="body"><div id="markets"></div><div class="err" id="mkErr" hidden></div></div></details>
<details class="sec" id="newsDet"><summary><span class="t"><span class="tt"><svg class="ni" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h13v13a2 2 0 0 0 2 2H6a2 2 0 0 1-2-2V5z"/><path d="M17 9h3v9a2 2 0 0 1-2 2"/><path d="M7 9h6M7 13h6M7 17h6"/></svg>News</span><small id="newsSub">Bitcoin, Strategy, Markt</small></span><span class="sum" id="newsSum"></span><svg class="ch" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary><div class="body">
  <div class="tabs" id="newsTabs"><button data-f="btc" class="on">Bitcoin</button><button data-f="mstr">Strategy</button><button data-f="all">Markt</button></div>
  <div id="news"><div class="mut skel">lädt…</div></div>
  <div class="note" id="newsNote"></div>
</div></details>
<details class="sec" id="stackDet"><summary><span class="t" id="stackSum">Bestand hinzufügen<small>optional, bleibt auf diesem Gerät</small></span><span class="sum" id="stackSumV"></span><svg class="ch" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></summary><div class="body">
    <div class="stackbox">
      <input id="stackIn" type="text" inputmode="decimal" placeholder="Bitcoin, z. B. 0,25">
      <button id="stackSave">Speichern</button>
      <button id="stackClear" class="ghost">Löschen</button>
    </div>
    <div class="note">Alle Zahlen oben bleiben je Bitcoin – dein Bestand wird nur zusätzlich klein angezeigt.</div>
  </div></details>
</div>

<footer>
  <span id="stamp">Kurse von Kraken.</span> <button id="reload">Aktualisieren</button><br>
  <span id="srcNote"></span>Kurs alle 30 Sekunden. Keine Anlageberatung.
</footer>

</div>

<script>
// ─────────────────────────────── state
const LS = { cur:'btc.cur', stack:'btc.stack', hist:'btc.hist3.' };
let cur = localStorage.getItem(LS.cur) || 'EUR'; if(!['EUR','USD','GOLD'].includes(cur)) cur='EUR';
let stack = parseFloat(localStorage.getItem(LS.stack)) || 0;
const D = { spot:{USD:null,EUR:null,GOLD:null}, eurusd:null, gold:null, goldHour:[], goldDay:[], hour:{USD:[],EUR:[],GOLD:[]}, day:{USD:[],EUR:[],GOLD:[]}, daySrc:{}, mk:null, mkState:'loading',
            plYear:1, b24Year:new Date().getFullYear(), month:new Date().getMonth(), height:null };
const MON = ['Jan','Feb','Mär','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'];
const MONL = ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];

// ─────────────────────────────── format
const nf = (v,d) => new Intl.NumberFormat('de-DE',{maximumFractionDigits:d,minimumFractionDigits:d}).format(v);
const fmtC = (v,c=cur,d) => v==null||isNaN(v) ? '–' : c==='GOLD' ? nf(v, d??(Math.abs(v)>=100?1:2))+' oz' :
  new Intl.NumberFormat('de-DE',{style:'currency',currency:c,maximumFractionDigits:d??(Math.abs(v)>=1000?0:2),minimumFractionDigits:d??(Math.abs(v)>=1000?0:2)}).format(v);
const fmtS = (v,c=cur) => v==null||isNaN(v) ? '–' : (v>0?'+':'')+fmtC(v,c,c==='GOLD'?(Math.abs(v)>=100?1:2):0);   // signed absolute
const fmtBig = (v,c=cur) => c==='GOLD' ? (v>=1e6?nf(v/1e6,2)+' Mio. oz':fmtC(v,c)) : v>=1e6 ? (c==='EUR'?'':'$ ')+nf(v/1e6,2)+' Mio.'+(c==='EUR'?' €':'') : fmtC(v,c);
const fmtP = (v,d=1) => v==null||isNaN(v) ? '–' : (v>0?'+':'')+nf(v,d)+' %';
const cls = v => v==null||isNaN(v) ? 'mut' : v>=0 ? 'pos' : 'neg';
const fmtX = v => v==null||isNaN(v) ? '–' : '×'+nf(v,v>=10?0:1);
const fmtBtc = v => new Intl.NumberFormat('de-DE',{maximumFractionDigits:8}).format(v)+' ₿';
const conv = usd => cur==='USD' ? usd : cur==='GOLD' ? (D.gold ? usd/D.gold : null) : (D.eurusd ? usd/D.eurusd : null);
const dateDE = d => d.toLocaleDateString('de-DE',{day:'2-digit',month:'2-digit',year:'numeric'});
const sleep = ms => new Promise(r=>setTimeout(r,ms));

// ─────────────────────────────── kraken (BTC)
const K = 'https://api.kraken.com/0/public/';
const PAIR = { USD:'XBTUSD', EUR:'XBTEUR' };
async function kraken(path){
  const r = await fetch(K+path); const j = await r.json();
  if(j.error && j.error.length) throw new Error(j.error.join(','));
  return j.result;
}
const firstKey = res => Object.keys(res).find(k=>k!=='last');

async function fetchSpot(){
  const res = await kraken('Ticker?pair=XBTUSD,XBTEUR,EURUSD,PAXGUSD');
  for(const k of Object.keys(res)){
    const last = parseFloat(res[k].c[0]);
    if(k.includes('XBT') && k.endsWith('USD')) D.spot.USD = last;
    else if(k.includes('XBT') && k.endsWith('EUR')) D.spot.EUR = last;
    else if(k.includes('EUR') && k.endsWith('USD')) D.eurusd = last;
    else if(k.includes('PAXG')) D.gold = last;
  }
  if(D.gold && D.spot.USD) D.spot.GOLD = D.spot.USD/D.gold;
  if(!D.eurusd && D.spot.USD && D.spot.EUR) D.eurusd = D.spot.USD/D.spot.EUR;
}
async function fetchHours(c){
  if(c==='GOLD'){ const res = await kraken('OHLC?pair=PAXGUSD&interval=60'); D.goldHour = res[firstKey(res)].map(r=>[r[0], parseFloat(r[4])]); deriveGold(); return; }
  const res = await kraken(`OHLC?pair=${PAIR[c]}&interval=60`);
  D.hour[c] = res[firstKey(res)].map(r=>[r[0], parseFloat(r[4])]);
  deriveGold();
}
// Gold-Jahresschluss USD/oz (LBMA, ca.) für die Zeit vor den Kraken-PAXG-Tageskerzen; dazwischen linear interpoliert
const GOLD_YE = {2011:1531,2012:1658,2013:1205,2014:1199,2015:1060,2016:1146,2017:1297,2018:1282,2019:1515,2020:1888,2021:1806,2022:1814,2023:2063,2024:2625,2025:4300};
function goldAt(t){
  const g=D.goldDay; if(g.length && t>=g[0][0]-86400){ let lo=0,hi=g.length-1,b=null; while(lo<=hi){const m=(lo+hi)>>1; if(g[m][0]<=t){b=g[m];lo=m+1;}else hi=m-1;} if(b) return b[1]; }
  const y=new Date(t*1000).getUTCFullYear(), a=GOLD_YE[y-1], b=GOLD_YE[y]||(g.length?g[0][1]:null); if(!a||!b) return null;
  const t0=Date.UTC(y-1,11,31)/1000, t1=Date.UTC(y,11,31)/1000; return a+(b-a)*Math.min(1,Math.max(0,(t-t0)/(t1-t0)));
}
function deriveGold(){
  if(D.goldHour.length && D.hour.USD.length){ const m=new Map(D.goldHour); D.hour.GOLD = D.hour.USD.filter(r=>m.has(r[0])).map(r=>[r[0], r[1]/m.get(r[0])]); }
  if(D.day.USD.length){ D.day.GOLD = D.day.USD.map(r=>{ const g=goldAt(r[0]); return g?[r[0], r[1]/g]:null; }).filter(Boolean); D.daySrc.GOLD = D.daySrc.USD; }
}
